/bin/
/dist/
/dist_*/
/preview*/
/_dev/

# Windows 构建期生成的插件软链：指向 pub-cache，跨机器无效
/windows/flutter/ephemeral/

# 占位：本机若存在其他 CMake/Qt 相关构建目录
/qt-build/

